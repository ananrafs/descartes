{
  "slug": "gundam_identifier",
  "evaluator": {
    "type": "evaluator.group.first_match",
    "evaluators": [
      {
        "type": "evaluator",
        "rule": {
          "name": "antagonist check",
          "type": "rules.conditional.or",
          "rules": [
            {
              "type": "rules.conditional.and",
              "rules": [
                {
                  "type": "rules.array.oneof",
                  "field": "universe",
                  "value": ["uc", "pd", "ac", "as", "ag"]
                },
                {
                  "type": "rules.bool",
                  "field": "using_mask",
                  "value": true
                }
              ]
            },
            {
              "type": "rules.array.struct.contains",
              "field": "gundam",
              "rule": {
                "type": "rules.conditional.and",
                "rules": [
                  {
                    "type": "rules.bool",
                    "field": "signature",
                    "value": true
                  },
                  {
                    "type": "rules.oneof",
                    "field": "code",
                    "value": [
                      "ORB-01",
                      "GAT-X105",
                      "EB-05s",
                      "MSN-02",
                      "RX-782"
                    ]
                  }
                ]
              }
            }
          ]
        },
        "action": {
          "antagonist": true,
          "gundam": "{{ gundam }}",
          "pilot": "{{ name }}",
          "universe": "{{ universe }}"
        }
      },
      {
        "type": "evaluator",
        "rule": {
          "type": "rules.conditional.and",
          "rules": [
            {
              "type": "rules.string.equal",
              "field": "universe",
              "value": "ce"
            },
            {
              "type": "rules.exist",
              "field": "gundam"
            }
          ]
        },
        "action": {
          "antagonist": false,
          "gundam": "{{ gundam }}",
          "pilot": "{{ name }}",
          "universe": "{{ universe }}"
        }
      },
      {
        "name": "default",
        "type": "evaluator",
        "rule": {
          "type": "rules.default"
        },
        "action": {
          "name": "{{ name }}",
          "status": "unidentified"
        }
      }
    ]
  }
}